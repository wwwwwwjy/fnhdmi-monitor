#!/bin/bash
# ============================================================
# fnmonitor 卸载后处理
# 根据用户选择决定是否删除监控历史数据（var 目录由系统保留）
# ============================================================
# 只停止并移除本应用安装的 VNC 模板服务；用户原有的 bash 登录脚本和备份保留。
if command -v systemctl >/dev/null 2>&1; then
    while read -r unit _rest; do
        case "$unit" in
            fnmonitor-x11vnc@*.service|fnmonitor-browser-vnc@*.service) systemctl disable --now "$unit" 2>/dev/null || true ;;
        esac
    done < <(systemctl list-units --all --type=service --no-legend 2>/dev/null)
fi
rm -f /etc/systemd/system/fnmonitor-browser-vnc@.service /etc/systemd/system/fnmonitor-x11vnc@.service 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
fi

if [ "${wizard_delete_data}" = "true" ]; then
    if [ -d "${TRIM_PKGVAR}" ]; then
        find "${TRIM_PKGVAR}" -mindepth 1 -delete 2>/dev/null || true
    fi
    echo "已删除监控历史数据"
else
    echo "已保留监控历史数据"
fi
exit 0
