#!/bin/bash
# ============================================================
# fnmonitor 卸载后处理
# 根据用户选择决定是否删除监控历史数据（var 目录由系统保留）
# ============================================================
# Replacement/upgrade may invoke this hook too. Never remove retained data in
# an upgrade/unknown context even if stale wizard_delete_data=true is supplied.
if [ "${TRIM_APP_STATUS:-}" != "UNINSTALL" ] || [ -n "${TRIM_OLD_APPVER:-}${TRIM_TEMP_UPGRADE_FOLDER:-}" ]; then
    echo "非明确卸载操作，保留全部监控数据。"
    exit 0
fi
# Actual uninstall: display cleanup has run before the app files were removed.

if [ "${wizard_delete_data}" = "true" ]; then
    if [ -d "${TRIM_PKGVAR}" ]; then
        find "${TRIM_PKGVAR}" -mindepth 1 -delete 2>/dev/null || true
    fi
    echo "已删除监控历史数据"
else
    echo "已保留监控历史数据"
fi
exit 0
