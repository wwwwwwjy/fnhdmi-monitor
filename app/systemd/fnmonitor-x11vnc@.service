[Unit]
Description=fnMonitor local-only VNC for the HDMI desktop (%i)
After=getty@tty1.service
ConditionPathExists=/tmp/.X11-unix/X0

[Service]
Type=simple
User=%i
Environment=DISPLAY=:0
WorkingDirectory=~
UMask=0077
ExecStartPre=/usr/bin/test -S /tmp/.X11-unix/X0
ExecStart=/usr/bin/x11vnc -display :0 -auth guess -localhost -rfbport 5900 -rfbauth .vnc/passwd -forever -shared -noxdamage
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
